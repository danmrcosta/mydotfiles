.{
    .libinput_device_rules = .{
        .{
            .name = .{ .str = "PIXA3807:01 093A:3807 Touchpad" },
            .tap = .enabled,
            .natural_scroll = .enabled,
        },
    },

    .xkb_keyboard_rules = .{
        .{
            .keymap = .{
                .options = .{
                    .layout = "br",
                    .variant = "abnt2",
                },
            },
        },
    },
}
